DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=fairstream
JWT_SECRET=change-me
ADMIN_KEY=change-me-too
# Blockchain (leave CONTRACT_ADDRESS empty to run in simulated mode)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
OWNER_KEY=
CONTRACT_ADDRESS=
KES_TO_WEI=1000000000000
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API=http://localhost:4000
# Optional: paste a Pinata JWT to pin uploads to IPFS
PINATA_JWT=
# Google sign-in: OAuth Client ID from Google Cloud Console (also set NEXT_PUBLIC_GOOGLE_CLIENT_ID in the web .env.local)
GOOGLE_CLIENT_ID=
# Password reset links: the address of your website (use 3001 if that is the port you run on)
WEB_URL=http://localhost:3000
# Optional email sending (leave SMTP_HOST empty and the reset link prints in this terminal instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Cloud database (leave DB_PORT/DB_SSL out for local XAMPP). Example for TiDB Cloud: DB_PORT=4000 and DB_SSL=true
DB_PORT=3306
DB_SSL=false
# Optional: your Pinata gateway, e.g. https://your-name.mypinata.cloud
PINATA_GATEWAY=
